APP_NAME=MetroCRM
ENVIRONMENT=development
SECRET_KEY=change-this-in-env
DATABASE_URL=sqlite:///./metrocrm.db

# Secure full CRM backups
BACKUP_ENABLED=true
BACKUP_TIMEZONE=Asia/Kolkata
BACKUP_LOCAL_PATH=./backups
# Optional mounted external disk on the same server process. Leave empty when using the desktop agent.
BACKUP_EXTERNAL_PATH=
# Strong secret used only by the trusted desktop backup agent; never commit the real value.
BACKUP_AGENT_TOKEN=generate-a-long-random-agent-secret
BACKUP_ENCRYPTION_KEY=generate-a-long-random-secret-and-keep-it-out-of-git
# Comma-separated destinations: s3,google_drive,onedrive
BACKUP_CLOUD_PROVIDERS=google_drive,onedrive
BACKUP_CLOUD_PROVIDER=none
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=

# Google Drive delegated OAuth. Keep credentials and refresh token only in deployment secrets.
BACKUP_GOOGLE_CLIENT_ID=
BACKUP_GOOGLE_CLIENT_SECRET=
BACKUP_GOOGLE_REFRESH_TOKEN=
BACKUP_GOOGLE_FOLDER_ID=

# Microsoft OneDrive / Graph delegated OAuth. Keep credentials and refresh token only in deployment secrets.
BACKUP_ONEDRIVE_TENANT=common
BACKUP_ONEDRIVE_CLIENT_ID=
BACKUP_ONEDRIVE_CLIENT_SECRET=
BACKUP_ONEDRIVE_REFRESH_TOKEN=
BACKUP_ONEDRIVE_FOLDER_PATH=MetroCRM-Backups

# External lead integrations. Enable only after the provider webhook/API is configured.
LEAD_INTEGRATIONS_ENABLED=true
MAGICBRICKS_ENABLED=false
NINETYNINEACRES_ENABLED=false
HOUSING_ENABLED=false
FACEBOOK_LEADS_ENABLED=false
INSTAGRAM_LEADS_ENABLED=false
GOOGLE_LEADS_ENABLED=false
META_ADS_ENABLED=false
OTHER_LEAD_WEBHOOK_ENABLED=true
INTEGRATION_WEBHOOK_SECRET=generate-a-long-random-webhook-secret
INTEGRATION_ENCRYPTION_KEY=generate-a-long-random-integration-secret

# OTP/SMS/Email providers. Keep test until real credentials and provider adapters are configured.
OTP_MOBILE_PROVIDER=test
OTP_EMAIL_PROVIDER=test
SMS_PROVIDER=test
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
EMAIL_PROVIDER=test
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=

# Instant customer-facing property/project visit alerts.
PROPERTY_VISIT_ALERTS_ENABLED=true
PROPERTY_VISIT_ALERT_COOLDOWN_SECONDS=60
