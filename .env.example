APP_NAME=MetroCRM
ENVIRONMENT=development
SECRET_KEY=change-this-in-env
DATABASE_URL=sqlite:///./metrocrm.db

# Secure full CRM backups
BACKUP_ENABLED=true
BACKUP_TIMEZONE=Asia/Kolkata
BACKUP_LOCAL_PATH=./backups
UPLOADS_PATH=./uploads
BACKUP_ENCRYPTION_KEY=generate-a-long-random-secret-and-keep-it-out-of-git

# Cloud backup: keep disabled until provider credentials are supplied
BACKUP_CLOUD_PROVIDER=none
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=
